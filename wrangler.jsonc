{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vlc-os-crm",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build && npx wrangler d1 migrations apply vlc-os-crm --remote"
  },
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": { "binding": "IMAGES" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vlc-os-crm",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vlc-os-contracts"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_EMAIL": "innocentigianni@proton.me",
    "ADMIN_NAME": "CRMVLC Super Admin",
    "EMAIL_FROM": "innocentigianni@proton.me",
    "SESSION_HOURS": "12"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
